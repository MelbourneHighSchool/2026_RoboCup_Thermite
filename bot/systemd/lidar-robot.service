[Unit]
Description=Thermite lidar-robot boot entrypoint (start.sh -> python -m bot.main)
After=multi-user.target

[Service]
Type=simple
User=thermite
WorkingDirectory=/home/thermite/Stuff
# ROBOT_ID selects bot1_config.py vs bot2_config.py (see bot/robot_select.py).
# This checked-in copy is for bot1's Pi; bot2's physical Pi needs its own
# copy of this unit with ROBOT_ID=2.
Environment=ROBOT_ID=1
ExecStart=/home/thermite/Stuff/start.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
